import logging
from abc import ABC, abstractmethod

# Archivo donde se guardan los eventos y errores
logging.basicConfig(
    filename="registro.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    encoding="utf-8",
)


# ---------------- Excepciones propias ----------------
class ErrorSistema(Exception):
    pass


class ClienteError(ErrorSistema):
    pass


class ServicioError(ErrorSistema):
    pass


class ServicioNoDisponible(ErrorSistema):
    pass


class ReservaError(ErrorSistema):
    pass


# ---------------- Clase abstracta general ----------------
class Entidad(ABC):
    def __init__(self, codigo):
        self.codigo = codigo

    @abstractmethod
    def mostrar_info(self):
        pass


# ---------------- Cliente ----------------
class Cliente(Entidad):
    def __init__(self, codigo, nombre, correo, telefono):
        super().__init__(codigo)

        # validaciones
        if nombre is None or len(nombre.strip()) < 3:
            raise ClienteError("el nombre debe tener minimo 3 letras")
        if correo is None or "@" not in correo or "." not in correo:
            raise ClienteError("el correo no es valido")
        if not str(telefono).isdigit() or len(str(telefono)) < 7:
            raise ClienteError("el telefono no es valido")

        # atributos privados
        self.__nombre = nombre.strip()
        self.__correo = correo
        self.__telefono = telefono

    def get_nombre(self):
        return self.__nombre

    def get_correo(self):
        return self.__correo

    def mostrar_info(self):
        return "Cliente " + str(self.codigo) + ": " + self.__nombre + " - " + self.__correo


# ---------------- Servicio (abstracta) ----------------
class Servicio(Entidad):
    def __init__(self, codigo, nombre, precio_hora):
        super().__init__(codigo)
        if precio_hora <= 0:
            raise ServicioError("el precio por hora debe ser mayor a 0")
        self.nombre = nombre
        self.precio_hora = precio_hora
        self.disponible = True

    @abstractmethod
    def calcular_costo(self, horas):
        pass

    @abstractmethod
    def validar_horas(self, horas):
        pass

    # "sobrecarga": el mismo metodo se puede llamar de varias formas
    # calcular_total(2)  /  calcular_total(2, 0.05)  /  calcular_total(2, 0.05, 0.1)
    def calcular_total(self, horas, impuesto=0.19, descuento=0):
        self.validar_horas(horas)
        if descuento < 0 or descuento >= 1:
            raise ServicioError("descuento fuera de rango")
        if impuesto < 0:
            raise ServicioError("impuesto negativo")
        costo = self.calcular_costo(horas)
        total = costo - (costo * descuento)
        total = total + (total * impuesto)
        return round(total, 2)


class SalaReuniones(Servicio):
    def calcular_costo(self, horas):
        return self.precio_hora * horas

    def validar_horas(self, horas):
        if horas <= 0 or horas > 12:
            raise ServicioError("las salas se reservan entre 1 y 12 horas")

    def mostrar_info(self):
        return "Sala " + self.nombre + " - $" + str(self.precio_hora) + " por hora"


class AlquilerEquipo(Servicio):
    def calcular_costo(self, horas):
        costo = self.precio_hora * horas
        # si es mas de un dia se hace 10% de descuento
        if horas > 24:
            costo = costo * 0.9
        return costo

    def validar_horas(self, horas):
        if horas <= 0 or horas > 72:
            raise ServicioError("los equipos se alquilan maximo 72 horas")

    def mostrar_info(self):
        return "Equipo " + self.nombre + " - $" + str(self.precio_hora) + " por hora"


class Asesoria(Servicio):
    def calcular_costo(self, horas):
        # la asesoria tiene recargo por ser especializada
        return self.precio_hora * horas * 1.5

    def validar_horas(self, horas):
        if horas < 0.5 or horas > 8:
            raise ServicioError("las asesorias duran entre 0.5 y 8 horas")

    def mostrar_info(self):
        return "Asesoria " + self.nombre + " - $" + str(self.precio_hora) + " por hora"


# ---------------- Reserva ----------------
class Reserva(Entidad):
    def __init__(self, codigo, cliente, servicio, horas):
        super().__init__(codigo)
        if cliente is None or servicio is None:
            raise ReservaError("faltan datos para crear la reserva")
        try:
            servicio.validar_horas(horas)
        except ServicioError as e:
            # encadenamiento de excepciones
            raise ReservaError("no se pudo crear la reserva") from e
        self.cliente = cliente
        self.servicio = servicio
        self.horas = horas
        self.estado = "Pendiente"
        self.total = 0

    def confirmar(self):
        if self.estado != "Pendiente":
            raise ReservaError("solo se confirman reservas pendientes")
        try:
            if not self.servicio.disponible:
                raise ServicioNoDisponible("el servicio " + self.servicio.nombre + " no esta disponible")
        except ServicioNoDisponible as e:
            raise ReservaError("no se pudo confirmar la reserva") from e
        else:
            self.estado = "Confirmada"
            logging.info("Reserva " + str(self.codigo) + " confirmada")
        finally:
            logging.info("Se intento confirmar la reserva " + str(self.codigo))

    def cancelar(self):
        if self.estado == "Cancelada" or self.estado == "Procesada":
            raise ReservaError("la reserva ya esta " + self.estado)
        self.estado = "Cancelada"
        logging.info("Reserva " + str(self.codigo) + " cancelada")

    def procesar(self, impuesto=0.19, descuento=0):
        if self.estado != "Confirmada":
            raise ReservaError("solo se procesan reservas confirmadas")
        try:
            total = self.servicio.calcular_total(self.horas, impuesto, descuento)
        except ErrorSistema as e:
            raise ReservaError("error al procesar la reserva") from e
        self.total = total
        self.estado = "Procesada"
        logging.info("Reserva " + str(self.codigo) + " procesada, total: " + str(total))
        return total

    def mostrar_info(self):
        return ("Reserva " + str(self.codigo) + " [" + self.estado + "] "
                + self.cliente.get_nombre() + " -> " + self.servicio.nombre
                + " (" + str(self.horas) + " h)")


# ---------------- Programa principal ----------------
def probar(texto, accion):
    """Ejecuta una operacion y si falla guarda el error pero el programa sigue."""
    try:
        resultado = accion()
    except ErrorSistema as e:
        mensaje = str(e)
        if e.__cause__ is not None:
            mensaje = mensaje + " (causa: " + str(e.__cause__) + ")"
        logging.error(texto + " -> " + mensaje)
        print("ERROR  - " + texto + ": " + mensaje)
    except Exception as e:
        logging.critical(texto + " -> error inesperado: " + str(e))
        print("ERROR  - " + texto + ": error inesperado: " + str(e))
    else:
        logging.info(texto + " -> OK")
        print("OK     - " + texto)
        return resultado
    finally:
        logging.info("Termino: " + texto)


def main():
    lista_clientes = []
    lista_servicios = []
    lista_reservas = []

    logging.info("----- Inicia la simulacion -----")

    print("=== CLIENTES ===")
    c1 = probar("Registrar cliente Ana", lambda: Cliente(1, "Ana Gomez", "ana@correo.com", "3001234567"))
    c2 = probar("Registrar cliente Luis", lambda: Cliente(2, "Luis Perez", "luis@correo.com", "3109876543"))
    probar("Registrar cliente con correo malo", lambda: Cliente(3, "Pedro", "pedrocorreo", "3001112233"))
    probar("Registrar cliente sin nombre", lambda: Cliente(4, "", "a@correo.com", "3001112233"))
    for c in (c1, c2):
        if c is not None:
            lista_clientes.append(c)

    print("\n=== SERVICIOS ===")
    s1 = probar("Crear sala de reuniones", lambda: SalaReuniones(1, "Sala A", 50000))
    s2 = probar("Crear alquiler de equipo", lambda: AlquilerEquipo(2, "Portatil", 8000))
    s3 = probar("Crear asesoria", lambda: Asesoria(3, "Python", 70000))
    probar("Crear sala con precio negativo", lambda: SalaReuniones(4, "Sala B", -100))
    probar("Crear servicio abstracto", lambda: Servicio(5, "Generico", 1000))
    for s in (s1, s2, s3):
        if s is not None:
            lista_servicios.append(s)

    print("\n=== RESERVAS ===")
    r1 = probar("Reserva sala 3 horas", lambda: Reserva(1, c1, s1, 3))
    r2 = probar("Reserva equipo 30 horas", lambda: Reserva(2, c2, s2, 30))
    probar("Reserva asesoria 20 horas", lambda: Reserva(3, c1, s3, 20))
    probar("Reserva sin cliente", lambda: Reserva(4, None, s1, 2))
    r5 = probar("Reserva asesoria 2 horas", lambda: Reserva(5, c2, s3, 2))
    for r in (r1, r2, r5):
        if r is not None:
            lista_reservas.append(r)

    print("\n=== CONFIRMAR, PROCESAR Y CANCELAR ===")
    if r1 is not None:
        probar("Confirmar reserva 1", r1.confirmar)
        probar("Procesar reserva 1", r1.procesar)
        probar("Cancelar reserva 1 (ya procesada)", r1.cancelar)
    if r2 is not None:
        probar("Confirmar reserva 2", r2.confirmar)
        probar("Procesar reserva 2 con descuento 150%", lambda: r2.procesar(0.19, 1.5))
        probar("Procesar reserva 2 con IVA 5% y descuento 10%", lambda: r2.procesar(0.05, 0.1))
    if r5 is not None:
        s3.disponible = False   # simulamos que la asesoria ya no esta disponible
        probar("Confirmar reserva 5 (servicio no disponible)", r5.confirmar)
        probar("Cancelar reserva 5", r5.cancelar)
        probar("Cancelar reserva 5 otra vez", r5.cancelar)

    print("\n=== RESUMEN ===")
    for c in lista_clientes:
        print(c.mostrar_info())
    for s in lista_servicios:
        print(s.mostrar_info())
    for r in lista_reservas:
        print(r.mostrar_info(), "| total:", r.total)

    logging.info("----- Termina la simulacion -----")
    print("\nLos errores y eventos quedaron guardados en registro.log")


main()
